  <String Id="FilesInUseLabel">Os aplicativos abaixo estão usando arquivos que precisam ser atualizados:</String>
  <String Id="FilesInUseCloseRadioButton">Fechar os &amp;aplicativos e tentar reiniciá-los.</String>
