<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="pt-BR" Language="1046" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <String Id="Caption">Instalação de [WixBundleName]</String>
  <String Id="Title">[WixBundleName]</String>
  <String Id="InstallVersion">Versão [WixBundleVersion]</String>
  <String Id="ConfirmCancelMessage">Tem certeza de que deseja cancelar?</String>
  <String Id="ExecuteUpgradeRelatedBundleMessage">Versão anterior</String>
  <String Id="HelpHeader">Ajuda da instalação</String>
  <String Id="HelpText">/install | /repair | /uninstall | /layout [diretório] - instala, repara, desinstala ou cria uma cópia local completa do pacote no diretório. A instalação é a ação padrão.

/passive | /quiet - exibe uma interface mínima sem perguntas ou não exibe interface nem perguntas. Por padrão, a interface e todas as perguntas são exibidas.

/norestart - impede tentativas de reinicialização. Por padrão, a interface solicita confirmação antes de reiniciar.
/log arquivo.log - grava o log no arquivo indicado. Por padrão, um log é criado em %TEMP%.</String>
  <String Id="HelpCloseButton">&amp;Fechar</String>
  <String Id="InstallAcceptCheckbox">&amp;Li e aceito os termos de licença</String>
